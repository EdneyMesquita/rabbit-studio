{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rabbit Studio",
  "mainBinaryName": "rabbit-studio",
  "version": "0.1.0",
  "identifier": "com.edneymesquita.rabbit-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rabbit Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#1e1f22"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "5b0e3c7a-9f2d-5d41-8a6e-2c7f1e4b9d30"
      }
    }
  }
}
